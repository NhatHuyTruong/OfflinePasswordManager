<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="vn.edu.hcmus.passman.ui.controllers.DashBoardController">
   
   <!-- Thanh công cụ phía trên -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         
         <Label text="Két Sắt Của Tôi">
            <font>
               <Font name="System Bold" size="18.0" />
            </font>
         </Label>
         
         <!-- Khoảng trống đẩy các nút sang bên phải -->
         <Region HBox.hgrow="ALWAYS" />
         
         <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#handleAdd" text="+ Thêm mới" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
         <Button fx:id="btnCopy" mnemonicParsing="false" onAction="#handleCopyPassword" text="Copy Mật Khẩu" disable="true" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
         <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEdit" text="Sửa" disable="true" />
         <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDelete" text="Xóa" disable="true" />
         <Button fx:id="btnLock" mnemonicParsing="false" onAction="#handleLock" text="Khóa Két" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
      </HBox>
   </top>

   <!-- Bảng dữ liệu ở giữa -->
   <center>
      <TableView fx:id="tableAccounts" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colService" prefWidth="150.0" text="Dịch vụ" />
          <TableColumn fx:id="colUsername" prefWidth="200.0" text="Tên đăng nhập" />
          <TableColumn fx:id="colUrl" prefWidth="200.0" text="URL / Website" />
          <TableColumn fx:id="colNote" prefWidth="150.0" text="Ghi chú" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   
</BorderPane>